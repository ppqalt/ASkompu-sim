#pragma once
#include <cstring>
namespace simulator::desktop::build {
inline constexpr const char* version = "@ASKOMPU_VERSION@";
inline constexpr const char* revision = "@ASKOMPU_REVISION@";
inline constexpr const char* upstreamBase = "@ASKOMPU_UPSTREAM_BASE@";
inline constexpr const char* coreRevision = "@ASKOMPU_ACTUAL_CORE_REVISION@";
inline constexpr const char* coreDate = "@ASKOMPU_CORE_DATE@";
inline constexpr const char* coreTag = "@ASKOMPU_CORE_TAG@";
inline constexpr const char* coreWorktree = "@ASKOMPU_CORE_WORKTREE@";
inline constexpr const char* worktree = "@ASKOMPU_WORKTREE@";
inline constexpr const char* coreFingerprint = "@ASKOMPU_CORE_FINGERPRINT@";
inline constexpr const char* simulatorFingerprint = "@ASKOMPU_SIMULATOR_FINGERPRINT@";
inline const char* configuration() {
  const char* name = ASKOMPU_BUILD_CONFIGURATION;
  return std::strcmp(name, "Debug") == 0 ? "Vianetsintä" : std::strcmp(name, "Release") == 0 ? "Julkaisu" : "Muu kehitysrakennus";
}
}
