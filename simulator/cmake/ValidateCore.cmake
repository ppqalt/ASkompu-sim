function(askompu_validate_snapshot)
  if(IS_SYMLINK "${ASKOMPU_CORE_SNAPSHOT}" OR IS_SYMLINK "${ASKOMPU_CORE_ROOT}")
    message(FATAL_ERROR "Paikallisen tilannekuvan juuri tai manifesti ei saa olla symbolinen linkki")
  endif()
  file(REAL_PATH "${ASKOMPU_CORE_SNAPSHOT}" manifest_path)
  if(NOT manifest_path STREQUAL "${ASKOMPU_CORE_ROOT}/snapshot-manifest.json")
    message(FATAL_ERROR "Tilannekuvan manifestin pitää sijaita sen omassa juurihakemistossa")
  endif()
  file(READ "${manifest_path}" manifest)
  string(JSON version GET "${manifest}" manifest_version)
  string(JSON kind GET "${manifest}" source_kind)
  string(JSON fingerprint GET "${manifest}" fingerprint)
  string(JSON revision GET "${manifest}" sha)
  string(JSON local_git GET "${manifest}" git)
  string(JSON local_dirty GET "${manifest}" dirty)
  string(LENGTH "${revision}" revision_length)
  string(LENGTH "${fingerprint}" fingerprint_length)
  if(NOT version EQUAL 1 OR NOT kind STREQUAL "local" OR
     NOT fingerprint_length EQUAL 64 OR NOT fingerprint MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Tuntematon tai virheellinen paikallisen tilannekuvan muoto")
  endif()
  if((NOT revision STREQUAL "tuntematon" AND (NOT revision_length EQUAL 40 OR NOT revision MATCHES "^[0-9a-f]+$")) OR
     (ASKOMPU_CORE_REVISION AND NOT ASKOMPU_CORE_REVISION STREQUAL revision) OR
     NOT local_git MATCHES "^[01]$" OR NOT local_dirty MATCHES "^[01]$")
    message(FATAL_ERROR "Tilannekuvan alkuperätiedot eivät vastaa valittua lähdettä")
  endif()
  string(JSON count LENGTH "${manifest}" files)
  if(count LESS 1)
    message(FATAL_ERROR "Tilannekuvan tiedostoluettelo puuttuu")
  endif()
  set(expected "")
  set(fingerprint_input "")
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON path GET "${manifest}" files ${index} path)
    string(JSON digest GET "${manifest}" files ${index} sha256)
    string(JSON size GET "${manifest}" files ${index} size)
    string(LENGTH "${digest}" digest_length)
    if(path MATCHES "[;\\\\:\n\r\t]" OR path MATCHES "(^|/)(\\.\\.?|)(/|$)" OR
       NOT (path MATCHES "^(src|include|test)/.+$" OR path MATCHES "^(LICENSE|LICENSE.txt|COPYING|platformio.ini)$") OR
       NOT digest_length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$" OR NOT size MATCHES "^[0-9]+$")
      message(FATAL_ERROR "Tilannekuvassa on virheellinen polku tai tiedostotunniste")
    endif()
    file(REAL_PATH "${ASKOMPU_CORE_ROOT}/${path}" actual_path)
    if(NOT actual_path STREQUAL "${ASKOMPU_CORE_ROOT}/${path}" OR IS_SYMLINK "${ASKOMPU_CORE_ROOT}/${path}" OR
       NOT EXISTS "${ASKOMPU_CORE_ROOT}/${path}" OR IS_DIRECTORY "${ASKOMPU_CORE_ROOT}/${path}")
      message(FATAL_ERROR "Tilannekuvan tiedosto puuttuu tai polku sisältää symbolisen linkin")
    endif()
    file(SHA256 "${ASKOMPU_CORE_ROOT}/${path}" actual_digest)
    file(SIZE "${ASKOMPU_CORE_ROOT}/${path}" actual_size)
    if(NOT actual_digest STREQUAL digest OR NOT actual_size EQUAL size)
      message(FATAL_ERROR "Paikallisen tilannekuvan tiedosto muuttui: ${path}")
    endif()
    list(APPEND expected "${path}")
    string(APPEND fingerprint_input "${path}:${digest}\n")
  endforeach()
  set(sorted "${expected}")
  list(REMOVE_DUPLICATES sorted)
  list(SORT sorted)
  string(SHA256 actual_fingerprint "${fingerprint_input}")
  if(NOT sorted STREQUAL expected OR NOT actual_fingerprint STREQUAL fingerprint)
    message(FATAL_ERROR "Tilannekuvan manifesti ei vastaa lähdetiivistettä")
  endif()
  file(GLOB_RECURSE actual LIST_DIRECTORIES TRUE RELATIVE "${ASKOMPU_CORE_ROOT}" "${ASKOMPU_CORE_ROOT}/*")
  set(actual_files "")
  foreach(path IN LISTS actual)
    if(IS_SYMLINK "${ASKOMPU_CORE_ROOT}/${path}")
      message(FATAL_ERROR "Tilannekuvaan on lisätty symbolinen linkki")
    endif()
    if(NOT IS_DIRECTORY "${ASKOMPU_CORE_ROOT}/${path}" AND NOT path STREQUAL "snapshot-manifest.json")
      list(APPEND actual_files "${path}")
    endif()
  endforeach()
  list(SORT actual_files)
  if(NOT actual_files STREQUAL expected)
    message(FATAL_ERROR "Paikallisen tilannekuvan tiedostoluettelo muuttui")
  endif()
endfunction()

function(askompu_validate_core)
  if(ASKOMPU_CORE_SNAPSHOT AND (IS_SYMLINK "${ASKOMPU_CORE_ROOT}" OR IS_SYMLINK "${ASKOMPU_CORE_SNAPSHOT}"))
    message(FATAL_ERROR "Paikallisen tilannekuvan juuri tai manifesti ei saa olla symbolinen linkki")
  endif()
  # Script-mode callers can supply native Windows separators or path aliases.
  file(REAL_PATH "${ASKOMPU_ROOT}" ASKOMPU_ROOT)
  file(REAL_PATH "${ASKOMPU_CORE_ROOT}" ASKOMPU_CORE_ROOT)
  if(NOT EXISTS "${ASKOMPU_CORE_ROOT}/src/core/ApplicationCore.cpp")
    message(FATAL_ERROR "Valitusta ASkompu-lähdehakemistosta puuttuu tuotantoydin")
  endif()
  if(ASKOMPU_CORE_SNAPSHOT)
    askompu_validate_snapshot()
    return()
  endif()
  if(NOT ASKOMPU_CORE_ROOT STREQUAL ASKOMPU_ROOT OR ASKOMPU_CORE_REVISION)
    string(LENGTH "${ASKOMPU_CORE_REVISION}" sha_length)
    if(NOT sha_length EQUAL 40 OR NOT ASKOMPU_CORE_REVISION MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Erillinen ASkompu-ydin tarvitsee täyden lukitun commit-SHA:n")
    endif()
    find_package(Git REQUIRED)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --show-toplevel
      WORKING_DIRECTORY "${ASKOMPU_CORE_ROOT}" OUTPUT_VARIABLE git_root
      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    file(REAL_PATH "${git_root}" git_root)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
      WORKING_DIRECTORY "${ASKOMPU_CORE_ROOT}" OUTPUT_VARIABLE actual
      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=normal
      WORKING_DIRECTORY "${ASKOMPU_CORE_ROOT}" OUTPUT_VARIABLE dirty COMMAND_ERROR_IS_FATAL ANY)
    if(NOT git_root STREQUAL ASKOMPU_CORE_ROOT OR NOT actual STREQUAL ASKOMPU_CORE_REVISION OR dirty)
      message(FATAL_ERROR "Valittu ASkompu-ydin ei vastaa lukittua puhdasta committia; rakennus estetty")
    endif()
  endif()
endfunction()
